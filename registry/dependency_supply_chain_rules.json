{
  "version": "1.0",
  "family": "dependency_supply_chain",
  "rules": {
    "EMS-CTRL-003": {
      "name": "Third-party dependency governance",
      "supported": true,
      "evidence_type": "DEPENDENCY_SCA_AUTOMATION",
      "checks": [
        {
          "type": "workflow_regex_any",
          "regex": "(?is)(dependabot|dependency[-_ ]check|snyk|trivy|grype|osv|pip-audit|npm audit|dotnet list .*vulnerable)",
          "assertion_id": "sca_or_dependency_scan_observed"
        }
      ],
      "pass_policy": "ALL",
      "derived_control_id": "EMS-CTRL-003"
    },
