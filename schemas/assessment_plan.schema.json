{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["assessment_plan_id","repository_id","repository_snapshot","classification_snapshot","effective_applicability_snapshot","ems_authorities","hayes","created_at","frozen_at","state","controls","execution_targets","evidence_requirements","human_review_requirements","plan_sha256"],"properties":{"assessment_plan_id":{"pattern":"^PLAN-[a-f0-9]{16}$"},"repository_id":{"pattern":"^REPO-(?:[1-9][0-9]*|EMS)$"},"repository_snapshot":{"type":"object"},"classification_snapshot":{"type":"object"},"effective_applicability_snapshot":{"type":"object"},"ems_authorities":{"type":"object"},"hayes":{"type":"object"},"created_at":{"format":"date-time"},"frozen_at":{"format":"date-time"},"state":{"const":"FROZEN"},"controls":{"type":"array"},"execution_targets":{"type":"array"},"evidence_requirements":{"type":"array"},"human_review_requirements":{"type":"array"},"plan_sha256":{"pattern":"^[a-f0-9]{64}$"}}}