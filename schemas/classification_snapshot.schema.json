{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["classification_snapshot_id","repository_id","repository_snapshot_sha256","captured_at","authority_reference","authority_sha256","attributes","classification_completeness","human_confirmation_state"],"properties":{"classification_snapshot_id":{"pattern":"^CLS-[a-f0-9]{16}$"},"repository_id":{"pattern":"^REPO-(?:[1-9][0-9]*|EMS)$"},"repository_snapshot_sha256":{"pattern":"^[a-f0-9]{64}$"},"captured_at":{"format":"date-time"},"authority_reference":{"type":"string"},"authority_sha256":{"pattern":"^[a-f0-9]{64}$"},"attributes":{"type":"object"},"classification_completeness":{"type":"object"},"human_confirmation_state":{"enum":["COMPLETE","INCOMPLETE"]}}}